# Copy this file to .env for machine-local launcher settings. AudioRegistry reads
# it only in run.ps1; .env is ignored by Git.
HF_TOKEN=
# Optional explicit UI/CLI locale: zh-CN, en-US, or ja-JP.
AUDIOREGISTRY_LANGUAGE=

# Optional absolute path to an existing Python environment.
AUDIOREGISTRY_PYTHON=

# Optional FFmpeg override; setup.ps1 otherwise installs a project-local build.
AUDIOREGISTRY_FFMPEG=
